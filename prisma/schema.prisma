generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  logoUrl        String?       @map("logo_url")
  primaryColor   String?       @default("#3B82F6") @map("primary_color")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  smtpHost       String?       @map("smtp_host")
  smtpPort       Int?          @map("smtp_port")
  smtpUser       String?       @map("smtp_user")
  smtpPassword   String?       @map("smtp_password")
  smtpFrom       String?       @map("smtp_from")
  paypalClientId String?       @map("paypal_client_id")
  paypalSecret   String?       @map("paypal_secret")
  reniecToken    String?       @map("reniec_token")
  reniecUrl      String?       @map("reniec_url")
  n8nWebhookUrl  String?       @map("n8n_webhook_url")
  maxCuotas      Int           @default(18) @map("max_cuotas")
  interestRate   Float         @default(12) @map("interest_rate")
  minInicial     Float         @default(3500) @map("min_inicial")
  auditLogs      AuditLog[]
  contracts      Contract[]
  cuotas         Cuota[]
  condiciones    TenantCondiciones?
  projects       Project[]
  quotations     Quotation[]
  subscription   Subscription?
  users          User[]

  @@map("tenants")
}

model User {
  id                String          @id @default(uuid())
  tenantId          String?         @map("tenant_id")
  email             String          @unique
  passwordHash      String          @map("password_hash")
  name              String
  role              UserRole        @default(ASESOR)
  canChangeStatus   Boolean         @default(false) @map("can_change_status")
  isActive          Boolean         @default(true) @map("is_active")
  assignedTenantIds String[]        @default([]) @map("assigned_tenant_ids")
  assignedProjectIds String[]       @default([]) @map("assigned_project_ids")
  lastActiveAt      DateTime?       @map("last_active_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  auditLogs         AuditLog[]
  contracts         Contract[]
  cuotasRegistradas Cuota[]         @relation("CuotaRegistro")
  assignedLots      Lot[]           @relation("AsesorLots")
  projectUpdates    ProjectUpdate[]
  lotDocuments      LotDocument[]
  quotations        Quotation[]
  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Project {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  name         String
  description  String?
  mapImageUrl  String?         @map("map_image_url")
  sheetsId     String?         @map("sheets_id")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  maxCuotas    Int             @default(60) @map("max_cuotas")
  minInicial   Float           @default(0) @map("min_inicial")
  interestRate Float           @default(0) @map("interest_rate")
  n8nWebhookUrl String?        @map("n8n_webhook_url")
  satCorners   Json?           @map("sat_corners")
  lots         Lot[]
  updates      ProjectUpdate[]
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@index([tenantId])
  @@map("projects")
}

model Lot {
  id           String        @id @default(uuid())
  projectId    String        @map("project_id")
  code         String
  manzana      String
  loteNumero   Int           @map("lote_numero")
  areaM2       Float         @map("area_m2")
  tipologia    String?
  etapa        String?
  frenteM      Float?        @map("frente_m")
  fondoM       Float?        @map("fondo_m")
  ladoDerM     Float?        @map("lado_der_m")
  ladoIzqM     Float?        @map("lado_izq_m")
  precioLista  Float         @map("precio_lista")
  descuentoMax Float         @default(0) @map("descuento_max")
  estado       LotStatus     @default(LIBRE)
  asesorId     String?       @map("asesor_id")
  mapShapeType String?       @map("map_shape_type")
  mapShapeData Json?         @map("map_shape_data")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  auditLogs    AuditLog[]
  contracts    Contract[]
  documents    LotDocument[]
  asesor       User?         @relation("AsesorLots", fields: [asesorId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([estado])
  @@map("lots")
}

model Quotation {
  id                 String      @id @default(uuid())
  codigo             String      @unique
  tenantId           String      @map("tenant_id")
  projectId          String      @map("project_id")
  lotId              String      @map("lot_id")
  userId             String      @map("user_id")
  estadoLoteAlEnviar LotStatus   @map("estado_lote_al_enviar")
  clienteDni         String      @map("cliente_dni")
  clienteNombres     String      @map("cliente_nombres")
  clienteApellidos   String      @map("cliente_apellidos")
  clienteEmail       String      @map("cliente_email")
  clienteFechaNac    DateTime?   @map("cliente_fecha_nac")
  precioLista        Float       @map("precio_lista")
  descuento          Float       @default(0)
  precioFinal        Float       @map("precio_final")
  inicial            Float
  cuotas             Int
  fechaInicio        DateTime    @map("fecha_inicio")
  cronograma         Json
  pdfUrl             String?     @map("pdf_url")
  emailStatus        EmailStatus @default(PENDING) @map("email_status")
  emailSentAt        DateTime?   @map("email_sent_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  lot                Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([lotId])
  @@map("quotations")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  lotId         String   @map("lot_id")
  userId        String   @map("user_id")
  campo         String
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  ipAddress     String?  @map("ip_address")
  motivo        String?
  createdAt     DateTime @default(now()) @map("created_at")
  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([lotId])
  @@map("audit_logs")
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  paypalSubscriptionId String?            @unique @map("paypal_subscription_id")
  plan                 SubscriptionPlan   @default(BASIC)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ASESOR
  LECTOR
}

enum LotStatus {
  LIBRE
  SEPARADO
  VENDIDO
  NO_DISPONIBLE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionPlan {
  BASIC
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String
  description String?
  percentage  Int      @default(0)
  imageUrl    String?  @map("image_url")
  authorId    String   @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@map("project_updates")
}

model LotDocument {
  id           String       @id @default(uuid())
  lotId        String       @map("lot_id")
  name         String
  type         DocumentType @default(OTRO)
  fileUrl      String       @map("file_url")
  uploadedById String       @map("uploaded_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  lot          Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([lotId])
  @@map("lot_documents")
}

enum DocumentType {
  PLANO
  ESCRITURA
  CONTRATO
  FOTO
  OTRO
}

model Contract {
  id                    String         @id @default(uuid())
  codigo                String         @unique
  tenantId              String         @map("tenant_id")
  lotId                 String         @map("lot_id")
  quotationId           String?        @map("quotation_id")
  userId                String         @map("user_id")
  tipo                  ContractType   @default(SEPARACION)
  estado                ContractEstado @default(BORRADOR) @map("estado")
  // Comprador principal
  clienteDni            String         @map("cliente_dni")
  clienteNombres        String         @map("cliente_nombres")
  clienteApellidos      String         @map("cliente_apellidos")
  clienteEmail          String         @map("cliente_email")
  clientePhone          String?        @map("cliente_phone")
  clienteDomicilio      String?        @map("cliente_domicilio")
  clienteEstadoCivil    String?        @map("cliente_estado_civil")
  // Financiero
  precioTotal           Float          @map("precio_total")
  descuentoPct          Float          @default(0) @map("descuento_pct")
  descuentoNivel        Int            @default(1) @map("descuento_nivel")
  descuentoAprobadoPor  String?        @map("descuento_aprobado_por")
  descuentoAprobadoCargo String?       @map("descuento_aprobado_cargo")
  montoSeparacion       Float?         @map("monto_separacion")
  inicial               Float?
  cuotasNum             Int?           @map("cuotas_num")
  tasaAnual             Float?         @map("tasa_anual")
  // Datos completos del wizard (JSON libre)
  datos                 Json?
  // Firma
  firmadoFisicamente    Boolean        @default(false) @map("firmado_fisicamente")
  fechaFirma            DateTime?      @map("fecha_firma")
  lugarFirma            String?        @map("lugar_firma")
  // Docs
  docxUrl               String?        @map("docx_url")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  cuotas                Cuota[]
  lot                   Lot            @relation(fields: [lotId], references: [id], onDelete: Cascade)
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([lotId])
  @@map("contracts")
}

model Cuota {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  contractId      String      @map("contract_id")
  numero          Int
  descripcion     String?
  monto           Float
  fechaVenc       DateTime    @map("fecha_venc")
  fechaPago       DateTime?   @map("fecha_pago")
  montoPagado     Float?      @map("monto_pagado")
  estado          CuotaStatus @default(PENDIENTE)
  metodoPago      String?     @map("metodo_pago")
  numOperacion    String?     @map("num_operacion")
  voucherUrl      String?     @map("voucher_url")
  registradoPorId String?     @map("registrado_por_id")
  registradoEl    DateTime?   @map("registrado_el")
  contract        Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registradoPor   User?       @relation("CuotaRegistro", fields: [registradoPorId], references: [id])

  @@index([tenantId])
  @@index([contractId])
  @@index([fechaVenc])
  @@map("cuotas")
}

model TenantCondiciones {
  id                   String   @id @default(uuid())
  tenantId             String   @unique @map("tenant_id")
  // Topes de descuento (%)
  descuentoContadoMax  Float    @default(5)   @map("descuento_contado_max")
  descuentoFinancMax   Float    @default(3)   @map("descuento_financ_max")
  descuentoExcepMax    Float    @default(10)  @map("descuento_excep_max")
  // Financiamiento
  tasaDefault          Float    @default(8)   @map("tasa_default")
  plazoMax             Int      @default(60)  @map("plazo_max")
  inicialMinPct        Float    @default(10)  @map("inicial_min_pct")
  // Aprobaciones
  tiempoAprobSeg       Int      @default(120) @map("tiempo_aprob_seg")
  aprobadores          Json     @default("[]") @map("aprobadores")
  // Otros
  penalidad            Float    @default(0.5) @map("penalidad")
  lucroCesante         Float    @default(0.5) @map("lucro_cesante")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_condiciones")
}

enum ContractType {
  SEPARACION
  COMPRAVENTA
}

enum ContractEstado {
  BORRADOR
  ACTIVO
  FIRMADO
  CANCELADO
}

enum CuotaStatus {
  PENDIENTE
  PAGADO
  VENCIDO
  PARCIAL
}
